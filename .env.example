# منفذ تشغيل الخادم
PORT=3000
# اسم/نطاق الموقع كما يظهر في الروابط (اختياري)
SITE_NAME=ملاحظاتي
# مسار قاعدة البيانات (اختياري — الافتراضي: ./data/mynotes.db)
# DB_PATH=./data/mynotes.db
# مدة صلاحية الجلسة بالأيام
SESSION_DAYS=30
# وضع الإنتاج: يفعّل ارتفاع الكوكيز الآمن (Secure)
NODE_ENV=production
